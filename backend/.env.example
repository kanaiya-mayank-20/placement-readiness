# ---- Required secrets (provide your own) ----
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Matching behaviour ----
# How many best companies a student sees on a match result
TOP_N_COMPANIES=3
# How many JDs enter the detailed scoring stage (retrieval funnel)
CANDIDATE_POOL_SIZE=50
# How many top results get an AI-written explanation
EXPLAIN_TOP_K=3

# ---- Optional ----
GEMINI_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
DATABASE_URL=
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# Students may only register as admin if they send this key
ADMIN_REGISTRATION_KEY=
CORS_ORIGINS=*
MAX_UPLOAD_MB=5
WORKER_CONCURRENCY=2
GITHUB_MAX_REPOS=30
GITHUB_DETAILED_REPOS=10
